# Copy this file to .env and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API Keys
#
# Only these two belong here. Both are safe to ship inside the app.
# NEVER put the secret / service_role key in this file or in .env -
# it ignores Row Level Security and belongs only inside Edge Functions.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
